---
/**
 * The navigation, rendered as a sheet index: sheet number and title.
 *
 * One horizontal row at the left of the head strip. It was a bordered block
 * down the right-hand side, which cost a 20rem column of every sheet for four
 * links — the drawings are the content here, and they get that width back.
 *
 * Six rows, photography among them. It used to be left out and reached from a
 * button on the About sheet, which made finding it depend on reading a
 * different sheet first. See getSheets in src/lib/sheets.ts.
 *
 * Sheet 02 carries the detail series under it, opening on hover or focus. That
 * is what a drawing index does for a series: the main index stays one line, and
 * the sheets under it are listed against the sheet they hang off. It is still
 * not a nav bar and still not a hamburger; it is the sub-sheet listing that has
 * been on the projects sheet all along, reachable from the band as well.
 *
 * The sub-sheet numbers are not repeated in the panel. The part number is the
 * designator anyone actually reads, and 02-1 through 02-5 would only restate
 * the row the panel is already hanging off.
 *
 * The panel is revealed by opacity rather than display, so its links stay in
 * the tab order and focusing the first one is what opens it. Hiding it with
 * `display: none` would make it hover-only, which is no navigation at all for
 * a keyboard. Below 1024px it is display:none and costs nothing: the band
 * wraps into the flow there, and the collection page lists the same sheets.
 *
 * Below 1024px it is a menu. The six rows and the sheet's identity and the
 * reproduction switch do not fit a phone across, and stacked they cost 184px of
 * masthead before a reader reaches the drawing — so the index folds behind a
 * button and opens as a panel. That is a hamburger, and this file used to say
 * it would never be one; the note was written when the index was four rows
 * wide enough to sit in the band on any screen, and it stopped being true when
 * the index grew. Above 1024px nothing has changed: the index is still laid out
 * in full across the band, and the button is not rendered.
 *
 * The toggle is a checkbox, not a button with script behind it, which is the
 * same device the photography filter uses. Navigation is the last thing on a
 * sheet that should depend on JavaScript loading: if the stylesheet fails the
 * list is simply visible, and if the script fails there is no script to fail.
 *
 * Titles stay in the body face: caps-mono is for metadata, never for link text.
 */
import { getSheets, getProjectSheets, sheetNo } from '../lib/sheets';

interface Props {
  /** Sheet number of the page this is rendered on, or 0 for none. */
  current: number;
}
const { current } = Astro.props;
const sheets = await getSheets();
const series = await getProjectSheets();

/** The sheet the detail series hangs off. */
const SERIES_PARENT = 2;

/**
 * Being marked as the current sheet and being the page you are on are not the
 * same thing, and the index used to treat them as one.
 *
 * A detail sheet belongs to sheet 02 and says so — the mark stays on Projects
 * the whole time you are reading a project. But sheet 02 is the parent there,
 * not the page: rendering it as plain text made the one row a reader on a
 * writeup most wants to click the only row they could not, with no way back up
 * to the collection except the footer at the end of a long sheet.
 *
 * So the mark still follows `current`, and the link follows the address. A row
 * is text only when you are standing on it.
 */
const norm = (path: string) => path.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname);
---

<nav class="sheetindex" aria-label="Sheet index">
  <input class="visually-hidden sheetindex__toggle" type="checkbox" id="sheet-index" />
  <label class="sheetindex__button" for="sheet-index">
    <span class="sheetindex__burger" aria-hidden="true"></span>
    <span>Index</span>
  </label>

  <ol class="sheetindex__list">
    {
      sheets.map((s) => (
        <li
          class:list={[
            'sheetindex__row',
            s.number === current && 'is-current',
            s.number === SERIES_PARENT && 'has-series',
          ]}
        >
          <span class="meta sheetindex__no">
            {s.number === current && <span class="sheetindex__mark" aria-hidden="true" />}
            {sheetNo(s.number)}
          </span>
          <span class="sheetindex__title">
            {norm(s.href) === here ? (
              <span aria-current="page">{s.title}</span>
            ) : (
              <a href={s.href} aria-current={s.number === current ? 'true' : undefined}>
                {s.title}
              </a>
            )}
          </span>

          {s.number === SERIES_PARENT && (
            <ul class="subindex" aria-label="Detail series">
              {series.map((d) => (
                <li class="subindex__row">
                  <span class="meta meta--ink subindex__pn">{d.partNumber}</span>
                  <a class="subindex__title" href={d.href}>
                    {d.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</nav>
