---
/**
 * A stretch of writing with the drawing that belongs to it, side by side.
 *
 * Used in a project's MDX body, one per section. The drawing alternates sides
 * down the sheet — text left, then text right — which is how a technical
 * article sets a run of figures, and which stops four plates in a column
 * reading as four identical blocks.
 *
 * Below 1024px there are no sides. The text comes first and the drawing sits
 * under it, because a drawing explains a paragraph that has already been read.
 *
 * `type` decides how the ground is handled, and it is the same distinction
 * AnnotatedFigure draws. A line drawing is black on white, so the white is
 * dropped and the lines are inverted on the blueprint — it becomes part of the
 * sheet. A figure carrying real colour cannot be inverted without turning a
 * stress plot into a photographic negative, so on the blueprint it keeps its
 * own white ground and reads as something printed and laid on the sheet.
 */
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /**
   * A blueprint cut of the same figure, where the ink that floats on the page
   * has been relit. Only for `type: figure`: a line drawing just inverts, but a
   * figure carrying photographs cannot, so its arrows and rules are relit in
   * the file and everything photographic is left alone. Both are in the markup
   * and one is hidden, because the reproduction can be pinned by hand and a
   * `<picture>` can only answer the operating system.
   */
  srcDark?: ImageMetadata;
  /** Required. A figure nobody can see is a figure nobody can read. */
  alt: string;
  /** Which side the drawing sits on above 1024px. */
  side?: 'left' | 'right';
  /** 'drawing' is black on white and joins the sheet; 'figure' keeps its ink. */
  type?: 'drawing' | 'figure';
  /**
   * Give the drawing more of the row. For a passage carrying two sections of
   * writing against one figure, the default split leaves the figure small and
   * the column beside it half empty. Wide moves the divide and drops the cap.
   */
  wide?: boolean;
}

const { src, alt, srcDark, side = 'right', type = 'drawing', wide = false } = Astro.props;

/* What the drawing actually lands at, for the browser to pick a candidate
   against. The content column less the 60px gap, split either 1:1 with the
   image at 85% of its half, or 1:1.25 with the image filling its share. */
const slot = wide ? '0.556' : '0.425';
const sizes = `(min-width: 1024px) calc((min(100vw, 1440px) - 180px) * ${slot}), calc(100vw - 40px)`;
---

<section class:list={['passage', `passage--${side}`, wide && 'passage--wide']}>
  <div class="passage__text">
    <slot />
  </div>

  <Image
    class:list={['passage__img', `passage__img--${type}`, srcDark && 'passage__img--paper']}
    src={src}
    alt={alt}
    widths={[400, 700, 1000]}
    sizes={sizes}
    loading="lazy"
    decoding="async"
  />

  {
    srcDark && (
      <Image
        class:list={['passage__img', `passage__img--${type}`, 'passage__img--blueprint']}
        src={srcDark}
        alt=""
        aria-hidden="true"
        widths={[400, 700, 1000]}
        sizes={sizes}
        loading="lazy"
        decoding="async"
      />
    )
  }
</section>
