---
/**
 * Which reproduction of the drawing package you are reading.
 *
 * The two themes are not "light" and "dark" on this site — they are the two
 * ways a drawing gets reproduced. One is printed on draft paper, one is run as
 * a blueprint, and the tokens are already named for it. The control says that
 * rather than naming a brightness.
 *
 * Each option carries a mark as well as a word. The mark is the conventional
 * one — sun for the lit sheet, moon for the dark — because the words here name
 * a reproduction rather than a brightness, and someone scanning the band for
 * the light/dark control should not have to read a metaphor first to find it.
 * The mark is decorative in the accessibility tree: the word beside it is the
 * accessible name, and a sun that also said "light" would say it twice.
 *
 * The buttons are in the markup but the sheet keeps them hidden until the
 * inline script in the head confirms scripting and adds `has-theme-control`.
 * That is the rule the drawing zoom already follows: a control that cannot
 * work should not be drawn. Rendering them hidden rather than injecting them
 * later is what keeps the head band from shifting once the script runs.
 *
 * Nothing here decides the initial theme. The head script does that before
 * first paint, so a pinned sheet never flashes the other reproduction first.
 */
---

<div class="themeswitch" role="group" aria-label="Reproduction">
  <button class="themeswitch__opt" type="button" data-theme-set="light" aria-pressed="false">
    <svg
      class="themeswitch__mark"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="8" cy="8" r="3.25" />
      <path d="M8 1.25v1.9M8 12.85v1.9M1.25 8h1.9M12.85 8h1.9" />
      <path d="M3.22 3.22l1.34 1.34M11.44 11.44l1.34 1.34M12.78 3.22l-1.34 1.34M4.56 11.44l-1.34 1.34" />
    </svg>
    <span>Draft paper</span>
  </button>
  <button class="themeswitch__opt" type="button" data-theme-set="dark" aria-pressed="false">
    <svg
      class="themeswitch__mark"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {/* A crescent: a disc of r=6.2 about the box centre, with a second disc
          of the same radius cut out of its upper right. The tips sit at the
          two intersections. Shifted 0.2 off the construction so the crescent's
          own bounding box — not the disc it was cut from — centres on 8,8;
          measured with getBBox rather than eyeballed. */}
      <path d="M14 10A6.2 6.2 0 1 1 6 2 6.2 6.2 0 0 0 14 10Z" />
    </svg>
    <span>Blueprint</span>
  </button>
</div>

<script>
  import '../scripts/theme';
</script>
