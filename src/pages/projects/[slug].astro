---
/**
 * Sheets 02-1 and up — one detail sheet per project.
 *
 * The spec has carried this as "not yet built" since the beginning. It is the
 * sheet the collection hands you: the drawing at full width with its callouts
 * live and a zoom control, then the part number and its fields, and the
 * write-up.
 *
 * It takes a real sheet number — 02-3, not a part number — because the
 * detail series is numbered off sheet 02 and always has been. The index still
 * marks sheet 02 as current, since that is the sheet this belongs to.
 *
 * This is where the annotation lives. The collection deliberately shows bare
 * drawings; a leader line needs the gutter it only has at this width.
 */
import { render } from 'astro:content';
import Sheet from '../../layouts/Sheet.astro';
import AnnotatedFigure from '../../components/AnnotatedFigure.astro';
import AsideView from '../../components/AsideView.astro';
import PartNumber from '../../components/PartNumber.astro';
import SectionMarker from '../../components/SectionMarker.astro';
import { getProjects, projectHref, statusStamp, subSheetNo } from '../../lib/sheets';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, projects },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  projects: CollectionEntry<'projects'>[];
}

const { project, index, projects } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const stamp = statusStamp(data.status);

/** A portrait drawing: taller than it is wide, so the sheet has room beside it. */
const isTall = !!data.heroImage && data.heroImage.height > data.heroImage.width;

/* Extra views of the part. They narrow the plate and, in doing so, buy the
   title block its corner: with the drawing no longer running the full width, a
   block banded underneath it would be a rule across half a sheet.

   A column is narrow and a strip is wide, so each view says which it wants.
   That used to be read off position instead, first to the column and the rest
   to the strip, which held while a sheet had one upright view and broke the
   moment one had two: there was no way to say that both belonged beside the
   drawing. `place` says it outright. */
const aside = data.aside;
const hasAside = aside.length > 0;
const asideColumn = aside.filter((v) => v.place === 'column');
const asideStrip = aside.filter((v) => v.place === 'strip');

const prev = projects[index - 1];
const next = projects[index + 1];
---

<Sheet
  sheetTitle={data.title}
  sheetNumber={2}
  description={data.summary}
>
  <section class="sheets" aria-labelledby="project-heading">
    <p class="project__pn">
      <PartNumber partNumber={data.partNumber} />
      {/* One stamp carries the status; "Current" alongside it said the same
          thing again, in the same red. */}
      <span class={stamp.class}>{stamp.label}</span>
      {data.started && <span class="meta">Started {data.started}</span>}

      {/* The way back to the collection, at the head of the sheet opposite the
          designator. The series footer has carried one all along, but that is
          the foot of a long sheet: a reader who opens a project, reads the
          first screen and wants the rest of the set had to scroll past the
          whole write-up to find it. The arrow leads here rather than trails,
          because this one goes back. */}
      <a class="sheetbutton project__up" href="/projects/">
        <span class="sheetbutton__arrow meta" aria-hidden="true">&larr;</span>
        <span>All projects</span>
      </a>
    </p>

    <h1 id="project-heading" class="sheettitle">{data.title}</h1>
    <p class="sheetlede">{data.summary}</p>

    {/* The domains this part sits in. Authored on every project and shown
        nowhere until now. Metadata, so it takes the metadata face. */}
    {
      data.tags.length > 0 && (
        <p class="project__tags">
          {data.tags.map((t) => (
            <span class="meta">{t.replace(/-/g, ' ')}</span>
          ))}
        </p>
      )
    }
  </section>

  {/* The drawing and the places this work is published, as one plate.
      The links used to sit at the very foot of the sheet, which is the last
      place a reader looks for them and a long way from the thing they are
      about. Directly under the drawing they read as part of it.

      A portrait drawing puts them beside it instead. A tall plate leaves a
      column of empty paper down one side — the callout labels use a fraction of
      it — and a column of empty paper is where the buttons belong. It also
      stops the drawing running the full width, which on a 975x1614 render meant
      most of a screen of robot. */}
  <div
    class:list={[
      'projectplate',
      isTall && 'projectplate--tall',
      hasAside && 'projectplate--aside',
    ]}
  >
    {/* The drawing and the stills under it. */}
    <div class="projectplate__main">
    <AnnotatedFigure
      cornerBlock={hasAside}
      gutter="legend"
      src={data.heroImage}
      alt={data.heroImageAlt ?? ''}
      callouts={data.callouts}
      imageType={data.heroImageType}
      figureId={data.partNumber}
      aspect={1.6}
      zoom
      pendingNote={
        data.status === 'active'
          ? `Coming soon: ${data.partNumber} is current work`
          : `${data.partNumber} has no drawing on file yet`
      }
      titleBlock={{
        partNumber: data.partNumber,
        title: data.title,
        started: data.started,
      }}
    />

    {
      asideStrip.length > 0 && (
        <div class="projectstrip">
          {asideStrip.map((v) => (
            <AsideView
              image={v.image}
              video={v.video}
              alt={v.alt}
              caption={v.caption}
              sizes="(min-width: 1024px) 32vw, 92vw"
            />
          ))}
        </div>
      )
    }
    </div>

    {/* The clip, and under it the way out. */}
    <div class="projectplate__side">
    {
      asideColumn.length > 0 && (
        <div class="projectaside">
          {asideColumn.map((v) => (
            <AsideView
              image={v.image}
              video={v.video}
              alt={v.alt}
              caption={v.caption}
              sizes="(min-width: 1024px) 24vw, 92vw"
            />
          ))}
        </div>
      )
    }

    {/* `--links` is the count, for the ceiling the buttons grow to beside a
        drawing. CSS can stretch them to fill a column but cannot count them,
        and the cap is per button rather than per list. */}
    {
      data.links.length > 0 && (
        <ul
          class="project__links"
          style={`--links:${data.links.length}`}
          aria-label="Published elsewhere"
        >
          {data.links.map((link) => (
            <li>
              {/* Every one of these leaves the site: a paper, an abstract, an
                  ISEF entry. They open in their own tab, because the sheet
                  they are printed on is a thing you come back to, and a reader
                  who opens the paper has not finished with the drawing.

                  `rel="noopener"` because a tab opened with target gets a
                  handle on the one that opened it otherwise. Modern browsers
                  imply it, older ones do not, and it costs nothing to say.

                  The new tab is announced rather than left to be discovered.
                  The icon says what the link opens and it is aria-hidden, so
                  without this a screen reader gets the label and no warning
                  that the window is about to change under it. */}
              <a
                class="sheetbutton plink"
                href={link.href}
                target="_blank"
                rel="noopener"
              >
                {/* What the button opens, drawn rather than described: a sheet
                    of paper with its corner turned for a PDF, a window with an
                    arrow leaving it for a page somewhere else. Decorative in
                    the accessibility tree — the label already says which. */}
                {link.href.endsWith('.pdf') ? (
                  <svg
                    class="plink__mark"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M9.5 1.5H4a.5.5 0 0 0-.5.5v12a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5V4.5z" />
                    <path d="M9.5 1.5v3h3" />
                  </svg>
                ) : (
                  <svg
                    class="plink__mark"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M8 2.5H2.5v11h11V8" />
                    <path d="M10 2.5h3.5V6" />
                    <path d="M13.5 2.5 7.5 8.5" />
                  </svg>
                )}
                <span>{link.label}</span>
                <span class="visually-hidden">(opens in a new tab)</span>
                <span class="sheetbutton__arrow meta" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    </div>
  </div>

  <SectionMarker letter="A" id="description" label="Description" />

  <section class="projectbody" aria-labelledby="description-heading">
    <h2 id="description-heading" class="visually-hidden">Description</h2>
    <Content />
  </section>

  {/* The set this sheet came out of, and the sheets either side of it. */}
  <nav class="seriesnav" aria-label="Detail series">
    <span class="seriesnav__prev">
      {prev && (
        <a href={projectHref(prev.id)}>
          <span class="meta meta--ink">{subSheetNo(index - 1)}</span>
          <span>{prev.data.title}</span>
        </a>
      )}
    </span>

    <a class="meta seriesnav__up" href="/projects/">All sheets</a>

    <span class="seriesnav__next">
      {next && (
        <a href={projectHref(next.id)}>
          <span class="meta meta--ink">{subSheetNo(index + 1)}</span>
          <span>{next.data.title}</span>
        </a>
      )}
    </span>
  </nav>
</Sheet>
