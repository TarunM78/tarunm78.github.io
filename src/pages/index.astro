---
/**
 * Sheet 1 — Home.
 *
 * A title sheet that runs into the package. The name card sits at the top and
 * the first drawing follows it directly — the sheet used to hold a screen of
 * empty paper below the name with a cue at the bottom telling you to scroll,
 * which is a page asking to be read in a particular order rather than simply
 * being read. Nothing here is pinned; the head band is what stays.
 *
 * Below the fold it is a continuous scroll through the front of each index, one
 * section per sheet it leads to: the first drawing, then the current role —
 * each shown the same way, a figure over a sentence, because each is the work.
 * Each section shows the first entry and links to the rest, so the home sheet is
 * the package's cover rather than a page of its own.
 */
import Sheet from '../layouts/Sheet.astro';
import AnnotatedFigure from '../components/AnnotatedFigure.astro';
import SectionMarker from '../components/SectionMarker.astro';
import {
  getExperience,
  getProjects,
  isCurrent,
  period,
  projectHref,
} from '../lib/sheets';
import { Image } from 'astro:assets';
import singleArm from '../assets/singlearm.png';

// The front of the project index, read rather than named, so the home sheet
// cannot end up pointing at a part that has been renumbered or moved off the
// set. It is the first sheet in the series that has a drawing on it, not simply
// the lowest part number: this sheet is the package's cover and its whole
// argument is a drawing over a sentence, so a pending plate here would be the
// cover saying there is nothing to see. The series order is untouched — only
// which sheet gets pulled to the front of the house.
const projects = await getProjects();
const hero = projects.find((p) => !!p.data.heroImage);
if (!hero) throw new Error('Home expects at least one project with a drawing on file.');

/**
 * How wide a drawing on this sheet actually lands, for the browser to pick a
 * candidate against. It restates `.lead .afig__stage` in design-system.css.
 *
 * Above 1024px the sheet is two columns. The content column is the sheet's
 * 1440px cap less its 60px margins; the 60px column gap comes off that; the
 * assembled drawing's column is 5 of the 12 parts left and the column beside
 * it — the single arm, the sentence, the buttons — is 7. So they are 5/12 and
 * 7/12, or 0.417 and 0.583, of `min(100vw, 1440px) - 180px`.
 *
 * Neither figure on this sheet carries labels now, so neither reserves a
 * gutter and both take that column whole. There was a second constant here for
 * the labelled case, at 0.463 — the column over the 1.26 a 26% gutter costs —
 * and it is gone with the callouts. Put it back if a home figure is ever
 * annotated again; a drawing measured as if it were full width while a quarter
 * of it holds labels is a drawing fetched at the wrong size.
 *
 * Below 1024px the layout is one column and the figure is the content column
 * outright, with --sheet-margin stepping 40px then 20px.
 *
 * Restated rather than read, because `sizes` is an HTML attribute and cannot
 * see a custom property. That makes these the numbers here that can quietly go
 * wrong: if the column split, the gap or --sheet-margin change, these have to
 * change with them. It is worth the duplication — a `sizes` that lies is not a
 * layout bug, it is a blurry drawing, and on line art this dense that is the
 * difference between a drawing and a smudge.
 */
const FIGURE_SIZES = [
  '(min-width: 1024px) calc((min(100vw, 1440px) - 180px) * 0.417)',
  '(min-width: 768px) calc(100vw - 80px)',
  'calc(100vw - 40px)',
].join(', ');

// The front of the experience index is whatever role is being held now.
const roles = await getExperience();
const role = roles[0];
if (!role) throw new Error('Home expects at least one experience entry.');
---

<Sheet
  sheetTitle="Home"
  sheetNumber={1}
  description="Tarun Malarvasan — mechanical engineering at Penn State, focused on robotics and humanoids."
>
  <div class="idblock">
    <h1 class="idblock__name">Tarun Malarvasan</h1>

    <div class="idblock__detail">
      <p class="meta meta--ink">Mechanical engineering, Penn State</p>
      <p class="meta meta--ink">Robotics and humanoids — actuators, mechanisms, perception</p>
      <p class="meta meta--ink">Researching at the Locomotion in Biology and Robotics Lab</p>
    </div>
  </div>

  {/* The label names the thing, rather than the shelf it came off. Both labels
      are read from the entry below them rather than typed here: the lead
      project and the leading role have each changed twice already, and a label
      that has to be edited by hand to stay true is a label that will one day
      be false. The marker is set in caps by the stylesheet, so the title's own
      casing does not matter here. */}
  <SectionMarker
    letter="A"
    id="current-project"
    label={`Current project: ${hero.data.title}`}
  />

  <section class="lead">
    {/* One arm of the pair, extended, at the head of the text column. It is a
        grid item like the sentence and the buttons under it, so it starts on
        row one — which is the row the drawing in column two starts on, and why
        the two line up along their top edge.

        It was a band across the whole sheet before. Beside the drawing rather
        than above it, the two read as one plate: the arm on its own at left,
        the pair assembled at right, and the sentence under the one it is about.

        Mirrored. The render has the arm reaching left, off the sheet; flipped
        it reaches toward the drawing it belongs to.

        Empty alt. It is the same arm the drawing beside it already describes in
        full, in a second pose — a reader using a screen reader gains nothing
        from hearing the subject twice. */}
    <Image
      class="sectionband"
      src={singleArm}
      alt=""
      widths={[600, 900, 1200, 1600]}
      sizes="(min-width: 1024px) calc((min(100vw, 1440px) - 180px) * 0.583), 0px"
      loading="eager"
      decoding="async"
    />

    {/* No callouts here, though the entry carries four. A leader line naming a
        shoulder actuator is a thing to read, and the cover is a thing to look
        at — they are on the detail sheet, which is where someone who wants the
        part numbers is going anyway. Dropping them also gives the drawing back
        the quarter of the column that was held open for the labels, so it runs
        out to the margin like every other block on the sheet. */}
    <AnnotatedFigure
      src={hero.data.heroImage}
      alt={hero.data.heroImageAlt ?? ''}
      caption={hero.data.title}
      imageType={hero.data.heroImageType}
      figureId={hero.data.partNumber}
      aspect={1.78}
      sizes={FIGURE_SIZES}
      eager
    />

    <p class="lead__summary">{hero.data.summary}</p>

    {/* Into this drawing, then out to the rest of the set: the specific thing
        first, since it is the thing already on screen. */}
    <p class="lead__more">
      <a class="sheetbutton" href={projectHref(hero.id)}>
        <span>Learn more</span>
        <span class="sheetbutton__arrow meta" aria-hidden="true">&rarr;</span>
      </a>
      <a class="sheetbutton" href="/projects/">
        <span>All projects</span>
        <span class="sheetbutton__arrow meta" aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </section>

  <SectionMarker
    letter="B"
    id="current-role"
    label={`Current role: ${role.data.role} @ ${role.data.org}`}
  />

  <section class="lead">
    <p class="lead__meta">
      <span class="meta meta--ink">{period(role.data.start, role.data.end)}</span>
      <span class="meta">{role.data.location}</span>
      {isCurrent(role) && <span class="tag-state">Current</span>}
    </p>

    {/* The same treatment the drawing above it gets, because it is the same
        kind of thing: the work, shown. The caption names the machine rather
        than the role and the org, which the section marker above has already
        stated in full — a sheet that says the same thing twice in two type
        sizes is a sheet arguing with itself. The caption is carried by the
        entry, so leading with a different role cannot leave the wrong machine
        named here. No callouts; the role carries none. */}
    <AnnotatedFigure
      src={role.data.heroImage}
      alt={role.data.heroImageAlt ?? ''}
      caption={role.data.heroCaption}
      imageType={role.data.heroImageType}
      figureId={`role-${role.id}`}
      aspect={1.78}
      sizes={FIGURE_SIZES}
    />

    <p class="lead__summary">{role.data.summary}</p>

    <p class="lead__more">
      <a class="sheetbutton" href="/experience/">
        <span>All experience</span>
        <span class="sheetbutton__arrow meta" aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </section>
</Sheet>
