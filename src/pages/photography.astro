---
/**
 * Photography — sheet 06.
 *
 * The one place the drawing vocabulary steps back: no part numbers, no
 * callouts, no title blocks. Photographs are not parts. It does carry a sheet
 * number, because that is the index to the page rather than a claim about what
 * is on it — and a page reachable only by first reading the About sheet is a
 * page most people never reach. What carries over is the plate — a bordered
 * frame with a mono caption strip under it — and the contact-sheet reading of
 * the whole grid.
 *
 * The filter is CSS only. A radio per category sits before the grid, and a
 * :checked sibling rule hides the plates that do not match, so filtering costs
 * no JavaScript and works with the keyboard for free because it is a real radio
 * group. Labels are what you see; the inputs are visually hidden but focusable.
 *
 * The order is shuffled on every visit. This is a static site, so there is no
 * request to randomise on — it has to happen in the browser, and it has to
 * happen before the first paint or the page shows its source order and then
 * visibly rearranges itself. Hence one inline, parser-blocking script directly
 * after the list, which is the same trick the theme pin uses in Sheet.astro and
 * for the same reason. With no JavaScript the source order stands, which is a
 * perfectly good order; nothing here depends on the shuffle having run.
 *
 * Images are resolved from src/assets/photography by glob at build time. A row
 * naming a file that is not there fails the build rather than rendering a hole.
 *
 * They are not lazy-loaded, and that is deliberate. CSS columns fill the first
 * column top to bottom before starting the second, so DOM order and reading
 * order do not agree: the first four frames all land in column one, and every
 * frame visible in columns two and three would be one the loader had decided
 * was below the fold. The result was a page of empty plates. The frames are the
 * content of this page, so they load.
 *
 * They also load at no stated priority. The first four used to be marked high,
 * on the reasoning that they are the ones on screen — which stopped being true
 * the moment the order became random. The preload scanner reads the markup
 * before the shuffle script runs, so the attribute cannot be corrected after
 * the fact either: it would be four arbitrary frames claiming to matter most.
 */
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';

const CATEGORIES = [
  { key: 'nature', label: 'Nature' },
  { key: 'places', label: 'Places' },
  { key: 'cars', label: 'Cars' },
] as const;

const photos = await getCollection('photography');

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photography/*.jpg',
  { eager: true }
);

/**
 * Each frame twice: the plate on the contact sheet, and a larger rendition for
 * the enlarged view.
 *
 * The grid's own candidates stop at 800px, which is right for a plate a third
 * of the sheet wide and far too small blown up to most of the window. The
 * originals are the other extreme — 5184px and several megabytes, which is
 * what clicking a frame used to hand you. 1600 on the long edge is the size
 * that is actually being looked at, and it is fetched only when a frame is
 * opened.
 *
 * Constrained on the long edge rather than on width, because a third of these
 * are portrait and `width: 1600` on a portrait frame is a 2100px-tall image to
 * show inside a window that is a thousand.
 */
const plates = await Promise.all(
  photos.map(async (p) => {
    const key = `../assets/photography/${p.data.file}`;
    const mod = files[key];
    if (!mod) {
      throw new Error(
        `photography.json references ${p.data.file}, which is not in src/assets/photography.`
      );
    }
    const src = mod.default;
    const long = src.width >= src.height ? { width: 1600 } : { height: 1600 };
    const full = await getImage({ src, format: 'webp', ...long });
    return { ...p.data, img: src, full: full.src };
  })
);

const countOf = (key: string) => plates.filter((p) => p.category === key).length;
---

<Sheet
  sheetTitle="Photography"
  sheetNumber={6}
  description="Photographs: nature, places and cars. A hobby, and the one sheet that carries none of the drawing vocabulary."
>
  <section class="sheets" aria-labelledby="photography-heading">
    <h1 id="photography-heading" class="sheettitle">Photography</h1>
  </section>

  <div class="gallery-filter">
    {/*
      The inputs must precede the grid and share a parent with it: the whole
      filter is one `:checked ~ .gallery` rule per category.
    */}
    <input
      class="visually-hidden gallery-filter__input"
      type="radio"
      name="subject"
      id="subject-all"
      checked
    />
    {
      CATEGORIES.map((c) => (
        <input
          class="visually-hidden gallery-filter__input"
          type="radio"
          name="subject"
          id={`subject-${c.key}`}
        />
      ))
    }

    <div class="filterbar" role="group" aria-label="Filter by subject">
      <label class="filterbar__label" for="subject-all">
        <span>All</span>
        <span class="meta filterbar__count">{plates.length}</span>
      </label>
      {
        CATEGORIES.map((c) => (
          <label class="filterbar__label" for={`subject-${c.key}`}>
            <span>{c.label}</span>
            <span class="meta filterbar__count">{countOf(c.key)}</span>
          </label>
        ))
      }
    </div>

    <ul class="gallery" id="gallery">
      {
        plates.map((p) => (
          <li class:list={['gallery__item', p.category && `is-${p.category}`]}>
            <figure class="plate">
              <a class="plate__link" href={p.img.src} data-full={p.full}>
                <Image
                  class="plate__img"
                  src={p.img}
                  alt={p.alt}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                  loading="eager"
                />
              </a>
              {/*
                Where, then when and on what — the order a photographer reads
                a frame back in. The place is the label and takes the ink; the
                month and the body are the exposure data under it and stay
                faint, which is the same two-tier setting the sheets use for a
                designator and its detail.
              */}
              <figcaption class="plate__cap">
                <span class="plate__id">
                  <span class="meta meta--ink">{p.location}</span>
                  <span class="meta plate__shot">
                    {p.date} &middot; {p.camera}
                  </span>
                </span>
                {p.category && <span class="meta plate__cat">{p.category}</span>}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    {/*
      Fisher-Yates over the plates, run where it sits: directly after the list,
      inline and blocking, so the reorder happens while the parser is still
      working and the page never paints the source order. Deferring it would
      show the shuffle happening.

      One pass, moving the elements themselves rather than their contents, so
      each plate keeps the image the caption belongs to.
    */}
    <script is:inline>
      (function () {
        var ul = document.getElementById('gallery');
        if (!ul) return;
        var items = Array.prototype.slice.call(ul.children);
        for (var i = items.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var swap = items[i];
          items[i] = items[j];
          items[j] = swap;
        }
        var frag = document.createDocumentFragment();
        for (var k = 0; k < items.length; k++) frag.appendChild(items[k]);
        ul.appendChild(frag);
      })();
    </script>
  </div>

  {/*
    The enlarged view. One dialog for the whole sheet, filled from whichever
    plate was clicked.

    A real <dialog>, unlike the drawing viewer in afig-viewer.ts, which had to
    be a plain fixed overlay because the top layer will not paint a blended,
    transformed line drawing. A photograph is not composited onto the paper, so
    that constraint is not this page's, and using the element gets the things
    worth having for nothing: the page behind goes inert, focus is trapped and
    returned to the frame you opened, Escape closes, and ::backdrop is a real
    surface that can carry the blur.

    The caption comes with it, in the same three fields the plate carries, so
    the enlarged frame is the same object rather than a bare image on a screen.
  */}
  <dialog class="lightbox" id="lightbox" aria-label="Photograph">
    <figure class="lightbox__plate">
      <img class="lightbox__img" alt="" />
      <figcaption class="plate__cap">
        <span class="plate__id">
          <span class="meta meta--ink" data-lb="where"></span>
          <span class="meta plate__shot" data-lb="shot"></span>
        </span>
        <span class="meta plate__cat" data-lb="cat"></span>
      </figcaption>
    </figure>
    <button class="lightbox__close meta" type="button" data-lb-close>Close</button>
  </dialog>

  {/*
    Open on click, and only on an ordinary one: a modified click is someone
    asking for a new tab, and the href is still the photograph, so it is left
    alone. Without JavaScript, or without <dialog>, the link does what it
    always did and opens the image.
  */}
  <script is:inline>
    (function () {
      var dlg = document.getElementById('lightbox');
      var grid = document.getElementById('gallery');
      if (!dlg || !grid || typeof dlg.showModal !== 'function') return;

      var img = dlg.querySelector('.lightbox__img');
      var field = function (name) {
        return dlg.querySelector('[data-lb="' + name + '"]');
      };

      grid.addEventListener('click', function (e) {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        // showModal() throws if the dialog is already open. A reader cannot
        // reach the grid past an open modal, but a synthetic click can.
        if (dlg.open) return;
        var link = e.target.closest('.plate__link');
        if (!link) return;
        e.preventDefault();

        var plate = link.closest('.plate');
        var thumb = plate.querySelector('.plate__img');
        var cap = plate.querySelector('.plate__cap');

        img.src = link.getAttribute('data-full') || link.href;
        img.alt = thumb ? thumb.alt : '';
        field('where').textContent = cap.querySelector('.meta--ink').textContent;
        field('shot').textContent = cap.querySelector('.plate__shot').textContent.trim();
        var cat = cap.querySelector('.plate__cat');
        field('cat').textContent = cat ? cat.textContent : '';

        dlg.showModal();
      });

      /* The margin around the plate is a way out; the plate itself is not.
         The dialog fills the window, so its own box IS that margin. */
      dlg.addEventListener('click', function (e) {
        if (e.target === dlg || e.target.hasAttribute('data-lb-close')) dlg.close();
      });

      /* Drop the source on close so a 1600px frame is not held for a sheet
         the reader may not open again. */
      dlg.addEventListener('close', function () {
        img.removeAttribute('src');
      });
    })();
  </script>
</Sheet>
