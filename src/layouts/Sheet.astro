---
/**
 * The layout every page uses. One sheet of the drawing package.
 *
 * Owns the printed grid and the head strip, which carries the sheet's identity
 * on the left and the sheet index on the right. Pages declare their metadata;
 * the Sheet renders it.
 *
 * The head strip is what stays fixed at 1024px and up — one thin band across the
 * full sheet, not a column down one side. Nothing is reserved horizontally, so a
 * drawing gets the whole width of the sheet, which is the point: the drawing is
 * the content and the chrome is a strip.
 *
 * There is no border drawn around the page and no title block in its corner.
 * A title block belongs to a drawing, not to a viewport, so it lives on the
 * drawings themselves — see AnnotatedFigure's `titleBlock` prop, where the
 * border and the block meet at a corner the way they do on a real sheet. What
 * that block used to carry at page level, the sheet's own number and date, is
 * in the head strip instead: still stated, stated once.
 */
import { Font } from 'astro:assets';
import SheetIndex from '../components/SheetIndex.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import PreliminaryStamp from '../components/PreliminaryStamp.astro';
import '../styles/global.css';

interface Props {
  /** Names the tab and heads the body. */
  sheetTitle: string;
  /** Which row the index marks as current. 0 for a sheet outside the index. */
  sheetNumber?: number;
  description?: string;
  /** Blog posts drop the grid to near-invisible and go quiet. */
  quiet?: boolean;
  /** Dev-only PRELIMINARY stamp for unapproved content. */
  preliminary?: boolean;
  bodyClass?: string;
}

const {
  sheetTitle,
  sheetNumber = 0,
  description,
  quiet = false,
  preliminary = false,
  bodyClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      The .ico first and the SVG after it: a browser that understands the SVG
      takes it whatever the order, and one that does not needs the .ico to be
      there rather than to be found by a bare request for /favicon.ico. The
      .ico carries 16 and 32 drawn separately — the small one is not the large
      one resampled, because a 1px rule does not survive that.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    {/*
      The pin, applied before first paint. It has to be inline and blocking:
      read it after the stylesheet and a sheet pinned to paper would flash
      blueprint first, on every navigation. It is the one script on the site
      that is not deferred, and it is this short for that reason.

      Adding the class here rather than in the deferred module is what lets the
      switch render hidden and appear without moving the head band.
    */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('sheet-theme');
          if (t === 'light' || t === 'dark')
            document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
        document.documentElement.classList.add('has-theme-control');
      })();
    </script>
    {description && <meta name="description" content={description} />}
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" preload />
    <Font cssVariable="--font-plex-serif" />
    <title>{sheetTitle} &middot; Tarun Malarvasan, mechanical engineering and robotics</title>
  </head>

  <body class:list={[quiet && 'sheet--quiet', bodyClass]}>
    <a class="skiplink" href="#sheet-body">Skip to content</a>

    <div class="sheet">
      {/* The index, then how the sheet is reproduced. It used to carry a third
          field between them naming the sheet you were already on and the date
          it was revised — a band that spent its middle restating the page you
          are looking at. The title is in the tab and at the head of the body,
          and a revision date means something on a drawing that gets revised,
          not on a page that is simply edited. What is left is the two things
          that act: the way off the page and the way it is drawn. */}
      <header class="sheet__head">
        <SheetIndex current={sheetNumber} />
        <ThemeSwitch />
      </header>

      <main class="sheet__body" id="sheet-body">
        <slot />
      </main>
    </div>

    {preliminary && <PreliminaryStamp />}
  </body>
</html>
